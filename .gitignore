# OrchDesk
node_modules/
dist/
lib/
release/
*.log
.DS_Store

# 打包前置生成物：dsh 依赖 + 插件产物（由 scripts/vendor-dsh.cjs 每次重建，不入版本库）
apps/desktop/vendor/

# dsh vendor（引用仓库，单独 git 管理，不纳入 OrchDesk 提交）
references/

# electron-builder PM 检测器怪癖：app 目录出现 package-lock.json 会让收集器
# 误判 npm 并在 pnpm workspace 下解析失败（ELSPROBLEMS）——项目由 pnpm 统一管理。
apps/desktop/package-lock.json

# 评审代理暂存副本（负样本隔离目录，误入库会成为第二份副本）
.review-tmp/

# 构建产物
*.tsbuildinfo
-out/

# 本地数据目录（运行时生成）
.orchdesk-home/
.dsh-home/
# WorkBuddy 会话临时缓存（skill 检查临时文件、chrome profile 等）
.workbuddy/tmp/
# 开发期 profile 的 node_modules（含指向 packages/bundle/desktop 的软链）
.dsh-home/profiles/node_modules/
.dsh-home/profiles/*/node_modules/
release-v*/
build-log.txt
apps/desktop/build/trace-token.local.txt
apps/desktop/build/trace-key.local
apps/desktop/build/trace-token.enc.json
_tmp_*
.git-broken-*
