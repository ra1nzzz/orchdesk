{
  "name": "@orchdesk/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "OrchDesk 桌面壳（Electron 主进程 + 渲染层桥接）",
  "main": "dist/main.js",
  "scripts": {
    "start": "pnpm run build:main && electron .",
    "build:main": "tsc -p tsconfig.json",
    "build": "pnpm run build:main && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.orchdesk.app",
    "productName": "OrchDesk",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": [
      {
        "target": [
          "nsis",
          "portable"
        ],
        "arch": [
          "x64"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      "github"
    ]
  }
}
