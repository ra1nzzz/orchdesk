  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {}
